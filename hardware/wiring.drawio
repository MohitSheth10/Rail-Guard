<mxfile host="app.diagrams.net" type="device"><diagram name="Hardware Wiring" id="railguard-wiring"><mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Rail-Guard — Hardware Wiring (single-accelerometer revision)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#102A43;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="760" height="30" as="geometry"/></mxCell><mxCell id="adapter" value="&lt;b&gt;12V / 2A Adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;mains power in&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="155" height="72" as="geometry"/></mxCell><mxCell id="buck" value="&lt;b&gt;XY-3606 Buck&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;12V → 5V converter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="155" height="72" as="geometry"/></mxCell><mxCell id="l298n" value="&lt;b&gt;L298N Driver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;drives 12V motors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="185" height="74" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;775 Motor 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;vibration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="75" width="108" height="60" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;775 Motor 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;vibration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="528" y="75" width="108" height="60" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;775 Motor 3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;(backup)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="651" y="75" width="108" height="60" as="geometry"/></mxCell><mxCell id="esp" value="&lt;b&gt;ESP32-S3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;Main controller · WiFi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="320" width="195" height="178" as="geometry"/></mxCell><mxCell id="acc" value="&lt;b&gt;Accelerometer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;MPU-6050 (or higher-accuracy)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="330" width="205" height="96" as="geometry"/></mxCell><mxCell id="load" value="&lt;b&gt;Load Cell (3 kg)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;clamp force&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="585" width="140" height="64" as="geometry"/></mxCell><mxCell id="hx1" value="&lt;b&gt;HX711 #1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;force ADC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="585" width="132" height="64" as="geometry"/></mxCell><mxCell id="strain" value="&lt;b&gt;Strain Gauges ×4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;full bridge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="675" width="140" height="64" as="geometry"/></mxCell><mxCell id="hx2" value="&lt;b&gt;HX711 #2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;force ADC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="675" width="132" height="64" as="geometry"/></mxCell><mxCell id="sd" value="&lt;b&gt;microSD Module&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;+32GB card · SPI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="140" height="64" as="geometry"/></mxCell><mxCell id="led" value="&lt;b&gt;Status LEDs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#486581;&quot;&gt;green=OK · red=fault&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=13;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="590" width="155" height="80" as="geometry"/></mxCell><mxCell id="notbox" value="&lt;b&gt;NOT PLACED IN WIRING&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;TCA9548A multiplexer&lt;/b&gt; — not needed for a single accelerometer (keep as spare)&lt;br&gt;&lt;br&gt;• &lt;b&gt;2nd ESP32-S3 + 2× HC-12&lt;/b&gt; — only for a wireless train↔base link (else use built-in WiFi)&lt;br&gt;&lt;br&gt;• &lt;b&gt;Spare MPU-6050 ×4&lt;/b&gt; — extras from the 5-sensor plan&lt;br&gt;&lt;br&gt;• &lt;b&gt;Assembly:&lt;/b&gt; breadboard, jumper/hook-up wire, PCB + headers, solder, flux, glue, USB cable&lt;br&gt;&lt;br&gt;• &lt;b&gt;Physical model:&lt;/b&gt; aluminium rails, MDF base, sleepers, steel fishplate, M5 bolts, acrylic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90A4AE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334E68;" vertex="1" parent="1"><mxGeometry x="865" y="470" width="270" height="278" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&amp;nbsp; &lt;font color=&quot;#E53935&quot;&gt;▬&lt;/font&gt; 12V &amp;nbsp; &lt;font color=&quot;#EF6C00&quot;&gt;▬&lt;/font&gt; 5V &amp;nbsp; &lt;font color=&quot;#1E88E5&quot;&gt;▬&lt;/font&gt; I²C &amp;nbsp; &lt;font color=&quot;#8E24AA&quot;&gt;▬&lt;/font&gt; GPIO &amp;nbsp; &lt;font color=&quot;#00897B&quot;&gt;▬&lt;/font&gt; SPI &amp;nbsp; &lt;font color=&quot;#6D4C41&quot;&gt;▬&lt;/font&gt; Analog" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;strokeColor=#D9E2EC;fillColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="800" height="40" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#E53935;strokeWidth=2.4;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="adapter" target="l298n"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="12V" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#E53935;strokeWidth=2.4;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="adapter" target="buck"><mxGeometry relative="1" as="geome